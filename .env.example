# ==============================================================================
# AI Lead Finder - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your personal API keys.
# NEVER commit your actual .env file or real API keys to version control.
#
# Note: AI Lead Finder also features a "Curated Sample Leads Mode" which runs
# completely offline with zero API keys required for testing and evaluation.
# ==============================================================================

# Search API Key (Tavily Search: https://tavily.com)
# Used to scour public web sources, classifieds, and news announcements.
TAVILY_API_KEY=your_tavily_api_key_here

# AI Model Provider Key (Google Gemini: https://aistudio.google.com)
# Used to extract structured lead data, compute relevance, and write rationale.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternative LLM Keys (Configure if switching providers in the UI)
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
